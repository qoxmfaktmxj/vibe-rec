# Public domain
DOMAIN=rec.minseok91.cloud

# Host ports (bound to loopback; exposed via nginx reverse proxy)
WEB_HOST_PORT=3400
API_HOST_PORT=39080
DB_HOST_PORT=5435

# Postgres
POSTGRES_DB=vibe_rec
POSTGRES_USER=vibe_rec
POSTGRES_PASSWORD=CHANGE_ME

# Admin dev account
APP_ADMIN_DEV_ACCOUNT_ENABLED=false
APP_ADMIN_DEV_ACCOUNT_USERNAME=admin
APP_ADMIN_DEV_ACCOUNT_PASSWORD=CHANGE_ME

# Candidate account email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
APP_CANDIDATE_MAIL_FROM=no-reply@example.com

# Distributed authentication rate limits
AUTH_RATE_LIMIT_HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
AUTH_RATE_LIMIT_CLEANUP_DELAY_MS=3600000
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_NETWORK_MAX_FAILURES=50
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_SIGNUP_MAX_REQUESTS=10
AUTH_PASSWORD_RESET_NETWORK_MAX_REQUESTS=20
AUTH_MAIL_MAX_REQUESTS=3
AUTH_MAIL_WINDOW_MINUTES=60
AUTH_MAIL_BLOCK_MINUTES=60
